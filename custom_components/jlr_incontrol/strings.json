{
  "config": {
    "step": {
      "user": {
        "title": "Jaguar Land Rover InControl",
        "description": "Sign in with your Land Rover Remote / InControl account. JLR will email you a verification code to finish. The PIN is only needed for remote commands (lock, climate, honk & flash).",
        "data": {
          "username": "Email",
          "password": "Password",
          "pin": "Vehicle security PIN (optional)"
        }
      },
      "init": {
        "title": "Jaguar Land Rover InControl options",
        "data": {
          "distance_unit": "Distance unit",
          "pressure_unit": "Pressure unit"
        }
      },
      "code": {
        "title": "Enter your verification code",
        "description": "JLR has emailed a code to {email}. Enter it here to finish signing in.\n\nThe code expires quickly, so enter it as soon as it arrives — if the sign-in session times out you'll be asked for your password again.",
        "data": {
          "code": "Verification code"
        }
      },
      "reauth_confirm": {
        "title": "Sign in to Jaguar Land Rover again",
        "description": "The saved sign-in for {email} has expired. Enter your password and JLR will email a new verification code.",
        "data": {
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Vehicle security PIN",
        "description": "The PIN unlocks the remote commands (lock, climate, honk & flash, charging). Leave it blank for monitoring only. This does not sign you in again.",
        "data": {
          "pin": "Vehicle security PIN"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid email or password.",
      "cannot_connect": "Could not reach the Jaguar Land Rover servers.",
      "invalid_code": "That verification code was not accepted. Check the email and try again.",
      "unsupported_journey": "JLR's sign-in did not follow the expected steps for this account. Please open an issue on GitHub with the details.",
      "session_expired": "Your sign-in session with JLR expired before the code was accepted — the window is short. Enter your password again and JLR will send a new code; have your email open before you submit.",
      "api_rejected": "Signed in successfully, but Jaguar Land Rover then refused the connection. Check the logs for the reason and please report it."
    },
    "abort": {
      "already_configured": "This account is already set up. If you can't see it, the existing entry may be disabled — go to Settings → Devices & Services, find Jaguar Land Rover InControl and enable it (it will then ask you to sign in again). Delete the existing entry first if you'd rather start fresh.",
      "reauth_successful": "Signed in again successfully.",
      "reconfigure_successful": "Vehicle PIN updated.",
      "unknown_entry": "That configuration entry no longer exists."
    }
  },
